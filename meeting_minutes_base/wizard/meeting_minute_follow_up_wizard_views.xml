<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_meeting_minute_follow_up_wizard_form" model="ir.ui.view">
        <field name="name">meeting.minute.follow.up.wizard.form</field>
        <field name="model">meeting.minute.follow.up.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear reunión de seguimiento">
                <sheet>
                    <group>
                        <group>
                            <field name="source_meeting_id" readonly="1"/>
                            <field name="source_partner_id" readonly="1"/>
                            <field name="follow_up_type"/>
                        </group>
                        <group>
                            <field name="scheduled_date"/>
                            <field name="duration" widget="float_time"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                    <group>
                        <field name="title"/>
                        <field name="location"/>
                    </group>
                    <group>
                        <field name="objective" nolabel="1"
                               placeholder="Objetivo de la nueva reunión..."/>
                    </group>
                    <group string="Opciones">
                        <field name="copy_attendees"/>
                        <field name="copy_pending_commitments"/>
                        <field name="open_after_create"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_follow_up" string="Crear reunión"
                            type="object" class="oe_highlight"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
