<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hour_wallet_type_list" model="ir.ui.view">
        <field name="name">hour.wallet.type.list</field>
        <field name="model">hour.wallet.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de bolsa" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hour_wallet_type_form" model="ir.ui.view">
        <field name="name">hour.wallet.type.form</field>
        <field name="model">hour.wallet.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de bolsa">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Descripción..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hour_wallet_type" model="ir.actions.act_window">
        <field name="name">Tipos de bolsa</field>
        <field name="res_model">hour.wallet.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
