<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_form_hour_wallet" model="ir.ui.view">
        <field name="name">project.project.form.hour.wallet</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_hour_wallets" type="object"
                        class="oe_stat_button" icon="fa-ticket">
                    <field name="hour_wallet_count" widget="statinfo" string="Bolsas"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="default_hour_wallet_id"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_task_form_hour_wallet" model="ir.ui.view">
        <field name="name">project.task.form.hour.wallet</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="hour_wallet_id"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
