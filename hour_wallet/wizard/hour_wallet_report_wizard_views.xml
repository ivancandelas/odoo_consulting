<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hour_wallet_report_wizard_form" model="ir.ui.view">
        <field name="name">hour.wallet.report.wizard.form</field>
        <field name="model">hour.wallet.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de consumo">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="wallet_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <field name="include_exhausted"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="group_by"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_preview" type="object"
                            string="Previsualizar PDF" class="btn-primary"/>
                    <button name="action_send_by_email" type="object"
                            string="Enviar por correo" class="btn-primary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hour_wallet_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte de consumo</field>
        <field name="res_model">hour.wallet.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
