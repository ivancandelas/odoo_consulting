<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hour_wallet_assign_timesheets_wizard_form" model="ir.ui.view">
        <field name="name">hour.wallet.assign.timesheets.wizard.form</field>
        <field name="model">hour.wallet.assign.timesheets.wizard</field>
        <field name="arch" type="xml">
            <form string="Asignar timesheets a bolsa">
                <sheet>
                    <group>
                        <group string="Bolsa destino">
                            <field name="wallet_id" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="project_id"/>
                            <field name="wallet_state"/>
                            <field name="hours_available" widget="float_time"/>
                        </group>
                        <group string="Filtros">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="restrict_to_project"/>
                            <field name="user_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <field name="task_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   domain="[
                                       ('project_id', '=', project_id),
                                       ('project_id', '!=', False),
                                   ]"
                                   invisible="not restrict_to_project or not project_id"/>
                            <field name="task_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   domain="[('partner_id', '=', partner_id)] if partner_id else []"
                                   invisible="restrict_to_project and project_id"/>
                        </group>
                    </group>
                    <div class="oe_highlight">
                        <button name="action_load_candidates" type="object"
                                string="Recargar candidatos"
                                class="btn-secondary"/>
                    </div>
                    <separator string="Timesheets a asignar"/>
                    <p class="text-muted">
                        Solo se listan timesheets sin bolsa asignada. Una vez
                        vinculados, no podrán moverse a otra bolsa.
                    </p>
                    <field name="line_ids"
                           options="{'no_create': True, 'no_open': True}"
                           domain="[
                               ('hour_wallet_id', '=', False),
                               ('project_id', '!=', False),
                               ('date', '&gt;=', date_from),
                               ('date', '&lt;=', date_to),
                           ]">
                        <list string="Candidatos">
                            <field name="date"/>
                            <field name="employee_id"/>
                            <field name="project_id"/>
                            <field name="task_id"/>
                            <field name="name"/>
                            <field name="unit_amount" sum="Total"
                                   widget="float_time"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="total_selected_hours" widget="float_time"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_assign" type="object"
                            string="Asignar" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hour_wallet_assign_timesheets_wizard" model="ir.actions.act_window">
        <field name="name">Asignar timesheets</field>
        <field name="res_model">hour.wallet.assign.timesheets.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
